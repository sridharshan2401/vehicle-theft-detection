# The app does not need any secrets. These optional variables only change
# where third-party libraries keep their caches.

# Where torchvision stores downloaded weights (default: %USERPROFILE%\.cache\torch)
# TORCH_HOME=C:\models\torch

# Hugging Face cache, used only by scripts/download_models.py --clothing
# HF_HOME=C:\models\huggingface

# Ultralytics settings folder (default: %APPDATA%\Ultralytics)
# YOLO_CONFIG_DIR=C:\models\ultralytics
